# Cloudflare tunnel token (Zero Trust > Networks > Tunnels)
CLOUD_FLARE_TUNNEL_TOKEN=

# Microsoft Entra ID app registration (see docs/entra-id-setup.md)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Random 32 byte secret: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Hostname where the OAuth callback lives, e.g. auth.example.com
AUTH_DOMAIN=
# Parent domain of AUTH_DOMAIN and all protected services, with leading dot, e.g. .example.com
COOKIE_DOMAIN=

# Optional: restrict by e-mail domain (default: any user of your tenant)
# ALLOWED_EMAIL_DOMAINS=example.com
